{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ApiSettings": {
    "BaseUrl": "http://localhost:3000",
    "RetryCount": 3,
    "ApiKey": "supersecret",
    "CircuitBreaker": {
      "FailureThreshold": 3,
      "DurationOfBreakSeconds": 15
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "Hangfire": {
    "InMemory": true
  },
  "AllowedHosts": "*"
}
